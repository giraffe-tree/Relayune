[Unit]
Description=Relayune MongoDB opaque API
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service

[Service]
Type=simple
User=agent-relay
Group=agent-relay
WorkingDirectory=/opt/agent-relay/current
EnvironmentFile=/etc/agent-relay/agent-relay.env
ExecStart=/opt/node-v22.22.2-glibc-217/bin/node /opt/agent-relay/current/server.cjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
