# Official hosted-service profile. Copy outside Git and replace all example values.
# Do not use the username-mode initialization or private-CA preparation command.
APP_ENV=server
HOST=127.0.0.1
PORT=3192
PUBLIC_ORIGIN=https://relayune.giraffetree.cn
RELAY_AUTH_MODE=email

# Retain the existing official database and runtime identity after live preflight.
# Candidate verification must use a separate database and private blob directory.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=your_official_database
MONGO_USER=your_official_runtime_user
MONGO_PASSWORD_FILE=/etc/relayune-official/mongo_password
RELAY_BLOB_DIR=/var/lib/relayune-official/blobs

# Use the sender and SMTP service you have verified; never commit their secrets.
MAIL_FROM=Relayune <verified-sender@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER_FILE=/etc/relayune-official/smtp_user
SMTP_PASSWORD_FILE=/etc/relayune-official/smtp_password

# Optional: grant monitoring explicitly; absence denies all accounts.
# MONITOR_ADMIN_EMAIL=operator@example.com
# SLS_PROJECT=your-project
# SLS_LOGSTORE=your-logstore
# SLS_REGION=cn-your-region
# SLS_READ_CREDENTIALS_FILE=/etc/relayune-official/sls-read-credentials.json
# REQUEST_LOG_HMAC_KEY_FILE=/etc/relayune-official/request-log-key.json

# Existing official APNs/JPush configuration may be retained outside Git.
# Missing push credentials do not justify weakening authentication or encryption.
