{
  "name": "relayune",
  "version": "0.3.33",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run community:assets && node scripts/build-web-with-provenance.mjs && node scripts/prepare-web-notices.mjs",
    "build:self-hosted": "npm run build && node scripts/build-self-hosted.mjs && node scripts/build-server-bundles.mjs",
    "community:assets": "node scripts/optimize-community-assets.mjs",
    "release-notes:publish": "node scripts/publish-release-notes.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs && npm --prefix desktop run generate:icons",
    "start": "node dist/self-hosted-server/server.cjs",
    "relay:mac": "node relay/cli.mjs relay",
    "relay:codex": "RELAY_ADAPTER=codex node relay/cli.mjs relay",
    "relay:kimi": "RELAY_ADAPTER=kimi node relay/cli.mjs relay",
    "relay:claude": "RELAY_ADAPTER=claude node relay/cli.mjs relay",
    "relay:claude-cowork": "RELAY_ADAPTER=claude-cowork node relay/cli.mjs relay",
    "relay:pi": "RELAY_ADAPTER=pi node relay/cli.mjs relay",
    "test:pi": "node --test tests/pi-rpc-client.test.mjs tests/pi-adapter.test.mjs tests/pi-provider-visibility.test.mjs",
    "test:pi:live": "node scripts/test-pi-rpc-live.mjs",
    "relay:multi": "RELAY_ADAPTER=multi node relay/cli.mjs relay",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:dev": "npm --prefix desktop run desktop:dev",
    "desktop:dev:windows": "npm --prefix desktop run desktop:dev:windows",
    "desktop:build": "npm --prefix desktop run desktop:build",
    "desktop:build:windows": "npm --prefix desktop run desktop:build:windows",
    "desktop:release": "node scripts/build-desktop-release.mjs",
    "desktop:check": "npm --prefix desktop run check",
    "desktop:test": "npm --prefix desktop test",
    "mobile:install": "node mobile/tool/flutter.mjs pub get",
    "mobile:check": "npm run test:mobile-map && node mobile/tool/flutter.mjs check",
    "mobile:simulator": "node scripts/ios-simulator-lease.mjs",
    "mobile:simulator:install": "node scripts/install-ios-simulator.mjs",
    "mobile:build:android": "node mobile/tool/flutter.mjs build appbundle --release",
    "mobile:android:install": "node scripts/install-android-usb.mjs",
    "mobile:periodic:prepare": "node scripts/prepare-periodic-android-artifact.mjs",
    "mobile:build:ios": "node mobile/tool/flutter.mjs build ios --release --no-codesign",
    "verify:self-hosted-e2ee": "node scripts/verify-production-e2ee.mjs",
    "verify:mongo-self-hosted": "node scripts/verify-mongo-self-hosted.mjs",
    "test": "npm run test:mobile-map && npm run build && node --test --test-concurrency=2 tests/*.test.mjs",
    "test:mobile-map": "node scripts/verify-mobile-test-map.mjs",
    "test:mobile-map:release": "node scripts/verify-mobile-test-map.mjs --release",
    "test:crypto": "node --test tests/e2ee-crypto.test.mjs tests/server-blindness.test.mjs tests/remote-e2ee-relay.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:publication": "node scripts/audit-publication.mjs",
    "verify:official-downloads": "node scripts/verify-official-downloads.mjs",
    "self-hosted:prepare": "node scripts/prepare-self-hosted.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "jpeg-js": "0.4.4",
    "mongodb": "^6.16.0",
    "nodemailer": "10.2.1",
    "qr-scanner": "^1.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "werift": "0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "mermaid": "11.17.2",
    "next": "16.4.3",
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "license": "MIT",
  "overrides": {
    "zod": "4.6.6",
    "mermaid": {
      "katex": "0.18.2"
    }
  }
}
