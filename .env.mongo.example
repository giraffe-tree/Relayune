APP_ENV=server
HOST=127.0.0.1
PORT=3192
# Use the HTTPS VPN address or public gateway configured by the installer.
PUBLIC_ORIGIN=https://192.0.2.10
# Username mode does not read SMTP secrets or contact a mail service.
# Use a separate database if switching between username and official email modes.
RELAY_AUTH_MODE=username
# Optional HTTP setup: generated outside the project, root-owned 0600/0640.
# Local account CLI can initialize the owner without enabling HTTP setup.
RELAY_SETUP_TOKEN_FILE=/etc/agent-relay/setup_token
# Source/installation root; secret paths must be outside this tree.
RELAY_PROJECT_ROOT=/opt/relayune
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=agent_relay
MONGO_USER=agent_relay
MONGO_PASSWORD_FILE=/etc/agent-relay/mongo_password
RELAY_BLOB_DIR=/var/lib/agent-relay/blobs

# Optional official email mode (RELAY_AUTH_MODE=email, separate database).
# MAIL_FROM=Relayune <no-reply@your-relayune.example>
# SENDMAIL_PATH=/usr/sbin/sendmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=owner@example.com
# SMTP_PASSWORD_FILE=/etc/agent-relay/smtp_password

# Monitoring access must be granted explicitly on this instance.
# Username mode: MONITOR_ADMIN_USERNAME=admin
# Email mode: MONITOR_ADMIN_EMAIL=admin@example.com
# Private JSON, root:agent-relay 0640. Configure all three SLS identifiers to enable queries.
# SLS_PROJECT=your-project
# SLS_LOGSTORE=your-logstore
# SLS_REGION=cn-your-region
# SLS_READ_CREDENTIALS_FILE=/etc/agent-relay/sls-read-credentials.json
# Local verification only; production uses the internal endpoint by default.
# SLS_USE_PUBLIC_ENDPOINT=1
