# Relayune Desktop/sidecar only. The desktop app injects these values from its
# non-secret configuration and encrypted application-data vault.
RELAY_SERVER_URL=https://your-relayune.example
RELAY_DEVICE_ID=
RELAY_DEVICE_TOKEN=
# JSON array of independently paired browser keys. Injected by the desktop app
# from per-browser encrypted-vault entries; do not copy or reuse a browser key.
RELAY_BROWSER_KEYS=[]
# Supported adapters: multi, codex, kimi, claude, claude-cowork.
RELAY_ADAPTER=multi
# Used when the unified UI opens and when a create request omits a provider.
RELAY_DEFAULT_PROVIDER=kimi
RELAY_WORKSPACE=/absolute/path/to/your/workspace
CODEX_BIN=
KIMI_BIN=/absolute/path/to/kimi
CLAUDE_BIN=/absolute/path/to/claude
# Optional override; otherwise discover the Claude CLI bundled with Cowork.
CLAUDE_COWORK_BIN=

# Web build options. API requests use the same origin by default.
NEXT_PUBLIC_RELAY_API_URL=
NEXT_PUBLIC_RELAY_ORIGIN=https://your-relayune.example
NEXT_PUBLIC_RELAY_ADAPTER=multi
NEXT_PUBLIC_RELAY_DEFAULT_PROVIDER=kimi
